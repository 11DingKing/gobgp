+
+func (z *zebraClient) setSessionClient(cli *zebra.Client) {
+	z.sessionMu.Lock()
+	z.client = cli
+	z.sessionMu.Unlock()
+}
+
+func (z *zebraClient) clearSessionClient(cli *zebra.Client) {
+	z.sessionMu.Lock()
+	if z.client == cli {
