+// waitBackoff sleeps for the given (jittered) backoff. It returns false when
+// the integration is stopped during the wait.
+func (z *zebraClient) waitBackoff(d time.Duration) bool {
+	timer := time.NewTimer(jitterBackoff(d))
+	defer timer.Stop()
+	select {
+	case <-z.ctx.Done():
+		return false
+	case <-timer.C:
+		return true
+	}
+}
